				}
			}
		},
		"/v1/dashboard/transactions": {
			"get": {
				"parameters": [
					{
						"schema": {
							"type": "string"
						},
						"in": "query",
						"name": "type",
						"required": false
					},
					{
						"schema": {
							"type": "string"
						},
						"in": "query",
						"name": "status",
						"required": false
					},
					{
						"schema": {
							"type": "string"
						},
						"in": "query",
						"name": "limit",
						"required": false
					},
					{
						"schema": {
							"type": "string"
						},

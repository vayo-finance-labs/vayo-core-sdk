			"get": {
				"operationId": "getV1DashboardApi-keys",
				"tags": ["Partner v1 — Dashboard"],
				"summary": "Partner's own API keys (prefix + metadata only, never plaintext)",
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/lending-operations/redeem-allocated/build": {
			"post": {
				"parameters": [
					{
						"schema": {
							"default": "false",
							"anyOf": [
								{
									"const": "true",
									"type": "string"
								},
								{
									"const": "false",
									"type": "string"
								}
							]
						},
						"in": "query",
						"name": "gasless",
						"required": false
					}
				],
				"operationId": "postV1Lending-operationsRedeem-allocatedBuild",
				"summary": "Mode S — build a partially-signed redeem tx",
				"description": "Builds a Kamino redeem transaction with the witness cosignature attached. The partner deserializes, adds the user wallet authority signature via their own Privy SDK, and submits via /submit (or directly to their own RPC).",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": [
									"privyDid",
									"marketAddress",
									"tokenMint",
									"amount"
								],
								"properties": {
									"privyDid": {
										"minLength": 1,
										"type": "string"
									},
									"marketAddress": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									},
									"tokenMint": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									},
									"amount": {
										"minLength": 1,
										"type": "string"
									},
									"reserveAddress": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									}
								}
							}
						},
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"required": [
									"privyDid",
									"marketAddress",
									"tokenMint",
									"amount"
								],
								"properties": {
									"privyDid": {
										"minLength": 1,
										"type": "string"
									},
									"marketAddress": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									},
									"tokenMint": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									},
									"amount": {
										"minLength": 1,
										"type": "string"
									},
									"reserveAddress": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									}
								}
							}
						},
						"text/plain": {
							"schema": {
								"type": "object",
								"required": [
									"privyDid",
									"marketAddress",
									"tokenMint",
									"amount"
								],
								"properties": {
									"privyDid": {
										"minLength": 1,
										"type": "string"
									},
									"marketAddress": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									},
									"tokenMint": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									},
									"amount": {
										"minLength": 1,
										"type": "string"
									},
									"reserveAddress": {
										"minLength": 32,
										"maxLength": 64,
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/lending-operations/redeem-allocated/submit": {
			"post": {
				"parameters": [],
				"operationId": "postV1Lending-operationsRedeem-allocatedSubmit",
				"summary": "Mode S — submit a fully-signed redeem tx (optional)",
				"description": "Verifies the witness/Kora cosignatures are still intact (Defense 2b — message hash re-verification) and submits to RPC. Optional: partners may submit directly to their own RPC instead and skip this endpoint entirely. The cryptographic anti-bypass guarantee holds either way.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["pendingRedeemId", "serializedTx"],
								"properties": {
									"pendingRedeemId": {
										"format": "uuid",
										"type": "string"
									},
									"serializedTx": {
										"minLength": 1,
										"type": "string"
									}
								}
							}
						},
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"required": ["pendingRedeemId", "serializedTx"],
								"properties": {
									"pendingRedeemId": {
										"format": "uuid",
										"type": "string"
									},
									"serializedTx": {
										"minLength": 1,
										"type": "string"
									}
								}
							}
						},
						"text/plain": {
							"schema": {
								"type": "object",
								"required": ["pendingRedeemId", "serializedTx"],
								"properties": {
									"pendingRedeemId": {
										"format": "uuid",
										"type": "string"
									},
									"serializedTx": {
										"minLength": 1,
										"type": "string"
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/rebalance/operations/{pendingOperationId}/confirm": {
			"post": {
				"parameters": [
					{
						"schema": {
							"type": "string",
							"format": "uuid"
						},
						"in": "path",
						"name": "pendingOperationId",
						"required": true
					}
				],
				"operationId": "postV1RebalanceOperationsByPendingOperationIdConfirm",
				"tags": ["Partner v1 — Rebalance"],
				"summary": "Confirm the outcome of an async rebalance operation",
				"description": "Signing proxy reports the result of submitting the atomic rebalance tx. Authenticated with a scoped API key (scope: `rebalance:operation:confirm`) and requires an `Idempotency-Key` header. Vayo independently verifies the reported signature on-chain before trusting confirmations.",
				"responses": {
					"200": {
						"description": "Confirmation accepted"
					},
					"401": {
						"description": "Invalid or missing API key"
					},
					"403": {
						"description": "API key missing required scope, or pending operation belongs to a different partner"
					},
					"422": {
						"description": "Signature not yet visible on-chain — partner should retry later"
					}
				},
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["signature", "status"],
								"properties": {
									"signature": {
										"minLength": 1,
										"maxLength": 128,
										"type": "string"
									},
									"status": {
										"anyOf": [
											{
												"const": "confirmed",
												"type": "string"
											},
											{
												"const": "failed",
												"type": "string"
											},
											{
												"const": "dropped",
												"type": "string"
											}
										]
									},
									"errorMessage": {
										"type": "string"
									}
								}
							}
						},
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"required": ["signature", "status"],
								"properties": {
									"signature": {
										"minLength": 1,
										"maxLength": 128,
										"type": "string"
									},
									"status": {
										"anyOf": [
											{
												"const": "confirmed",
												"type": "string"
											},
											{
												"const": "failed",
												"type": "string"
											},
											{
												"const": "dropped",
												"type": "string"
											}
										]
									},
									"errorMessage": {
										"type": "string"
									}
								}
							}
						},
						"text/plain": {
							"schema": {
								"type": "object",
								"required": ["signature", "status"],
								"properties": {
									"signature": {
										"minLength": 1,
										"maxLength": 128,
										"type": "string"
									},
									"status": {
										"anyOf": [
											{
												"const": "confirmed",
												"type": "string"
											},
											{
												"const": "failed",
												"type": "string"
											},
											{
												"const": "dropped",
												"type": "string"
											}
										]
									},
									"errorMessage": {
										"type": "string"
									}
								}
							}
						}
					}
				}
			}
		},
		"/health/mode-s": {
			"get": {
				"operationId": "getHealthMode-s",
				"responses": {
					"200": {}
				}
			}
		}
	}
}

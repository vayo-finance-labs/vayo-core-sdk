				"responses": {
					"200": {}
				}
			}
		},
		"/v1/dashboard/investment-performance": {
			"get": {
				"operationId": "getV1DashboardInvestment-performance",
				"tags": ["Partner v1 — Dashboard"],
				"summary": "Aggregated investment performance — total yield, volume, user count across windows (NOT performance fees)",
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/dashboard/performance-fees": {
			"get": {
				"operationId": "getV1DashboardPerformance-fees",
				"tags": ["Partner v1 — Dashboard"],
				"summary": "Legacy alias of /partner-fees — performance fees collected from the partner's users",
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/dashboard/partner-fees": {
			"get": {
				"operationId": "getV1DashboardPartner-fees",
				"tags": ["Partner v1 — Dashboard"],
				"summary": "Partner's earned fee share (NOT investment performance) — current model, bps, totals across windows",
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/dashboard/partner-fees/payouts": {
			"get": {
				"parameters": [
					{
						"schema": {
							"type": "string"
						},
						"in": "query",
						"name": "limit",
						"required": false
					},
					{
						"schema": {
							"type": "string"
						},

												"type": "array",
												"items": {
													"minLength": 32,
													"maxLength": 64,
													"type": "string"
												}
											},
											{
												"type": "null"
											}
										]
									},
									"allowedReserveAddresses": {
										"anyOf": [
											{
												"type": "array",
												"items": {
													"minLength": 32,
													"maxLength": 64,
													"type": "string"
												}
											},
											{
												"type": "null"
											}
										]
									}
								}
							}
						},
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"properties": {
									"allowedMarketAddresses": {
										"anyOf": [
											{
												"type": "array",
												"items": {
													"minLength": 32,
													"maxLength": 64,
													"type": "string"
												}
											},
											{
												"type": "null"
											}
										]
									},
									"allowedReserveAddresses": {
										"anyOf": [
											{
												"type": "array",
												"items": {
													"minLength": 32,
													"maxLength": 64,
													"type": "string"
												}
											},
											{
												"type": "null"
											}
										]
									}
								}
							}
						},
						"text/plain": {
							"schema": {
								"type": "object",
								"properties": {
									"allowedMarketAddresses": {
										"anyOf": [
											{
												"type": "array",
												"items": {
													"minLength": 32,
													"maxLength": 64,
													"type": "string"
												}
											},
											{
												"type": "null"
											}
										]
									},
									"allowedReserveAddresses": {
										"anyOf": [
											{
												"type": "array",
												"items": {
													"minLength": 32,
													"maxLength": 64,
													"type": "string"
												}
											},
											{
												"type": "null"
											}
										]
									}
								}
							}
						}
					}
				},
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/dashboard/overview": {
			"get": {
				"operationId": "getV1DashboardOverview",
				"tags": ["Partner v1 — Dashboard"],
				"summary": "Partner dashboard home — users, volume, fees, consumption at a glance",
				"responses": {
					"200": {}

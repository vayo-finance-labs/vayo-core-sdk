{
	"openapi": "3.0.3",
	"info": {
		"title": "Vayo Finance Partner API",
		"description": "Partner-facing v1 routes for the Vayo Finance lending platform.\nCovers Mode V (Vayo signs) and Mode S (partner self-signs) flows,\npartner self-service dashboards, and the Mode S health check.\n\nVayo-internal admin endpoints are intentionally excluded — they\nlive behind `adminGuard` and are not part of the partner contract.\n\nQuickstart: docs/core-sdk/quickstart.md\nSource: apps/api/src/presentation/routes/v1/",
		"version": "1.0.0",
		"contact": {
			"name": "Vayo Engineering",
			"email": "partners@vayo.finance"
		}
	},
	"servers": [
		{
			"url": "https://api.vayo.finance",
			"description": "Production"
		},
		{
			"url": "https://api.staging.vayo.finance",
			"description": "Staging"
		},
		{
			"url": "http://localhost:3001",
			"description": "Local"
		}
	],
	"tags": [
		{
			"name": "Partner v1 — Auth",
			"description": "Authenticate a partner-user via the partner Privy app (Mode V)."
		},
		{
			"name": "Partner v1 — Wallets",
			"description": "Read the partner-user's wallet address and on-chain balances."
		},
		{
			"name": "Partner v1 — Lending",
			"description": "Read-only market and reserve data filtered by the partner's allowlist."
		},
		{
			"name": "Partner v1 — Lending Operations",
			"description": "Mode V supply/redeem and Mode S build/submit endpoints."
		},
		{
			"name": "Partner v1 — Dashboard",
			"description": "Self-service partner analytics — users, transactions, fees, consumption."
		},
		{
			"name": "Partner v1 — Rebalance",
			"description": "Rebalance operation confirmations from the partner signing proxy."
		},
		{
			"name": "Health",
			"description": "Mode S subsystem health check."
		}
	],
	"components": {
		"securitySchemes": {
			"PartnerApiKey": {
				"type": "apiKey",
				"in": "header",
				"name": "x-api-key",
				"description": "Partner API key issued via `POST /admin/partners/:id/api-keys`. Format: `vayo_pk_<32 chars>`."
			},
			"PartnerUserJwt": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "JWT",
				"description": "Privy access token for the partner-user. Validated against the partner's Privy app."
			}
		},
		"schemas": {}
	},
	"security": [
		{
			"PartnerApiKey": []
		}
	],
	"paths": {
		"/v1/lending/markets": {
			"get": {
				"operationId": "getV1LendingMarkets",
				"tags": ["Partner v1 — Lending"],
				"summary": "List lending markets — filtered by the partner's allowlist (intersection with global)",
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/lending/reserves": {
			"get": {
				"parameters": [
					{
						"schema": {
							"type": "string"
						},
						"in": "query",
						"name": "mints",
						"required": false
					}
				],
				"operationId": "getV1LendingReserves",
				"tags": ["Partner v1 — Lending"],
				"summary": "Flat list of reserves across markets — filtered by partner allowlist",
				"responses": {
					"200": {}
				}
			}
		},
		"/v1/lending/markets/available": {
			"get": {
				"operationId": "getV1LendingMarketsAvailable",
				"tags": ["Partner v1 — Lending"],
				"summary": "List all Vayo-approved markets (global whitelist) — ignores the partner allowlist",
				"responses": {
					"200": {}
				}
			}
		},
